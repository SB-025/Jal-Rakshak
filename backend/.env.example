MONGODB_URI=
MONGODB_DB=jal_rakshak
LOGIN_USERNAME=niox
# Generated in the local .env; salted PBKDF2-SHA256 hash (600000 iterations).
LOGIN_PASSWORD_HASH=
# Use a random secret of at least 32 characters.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-side Ollama Cloud; never use a VITE_ variable for this key.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Optional MODEL_DIR points to locally trained model artifacts.

# Device state reports older than this become unknown.
MOTOR_STATE_TTL_SECONDS=300
